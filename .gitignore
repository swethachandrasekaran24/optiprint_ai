# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#1255, pipenv should generally not be check into control.
#   However, if you're deploying an application, you're expected to check Pipfile.lock in.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock should be trackable if you're deploying.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is co-managed by pdm and is recommended to commit.
#pdm.lock

# virtualenv
.env
.venv
env/
venv/
ENV/
env.bak/
